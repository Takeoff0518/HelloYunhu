# NoneBot2 测试机器人配置。复制为 .env 后使用，.env 不进入版本库。

# 使用反向驱动器，Adapter 会在该端口上提供反向 WebSocket 端点。
DRIVER=~fastapi

HOST=127.0.0.1
PORT=8080

# 访问令牌。第一轮测试先留空，把协议跑通后再与 helloyunhu 的 access_token 一起设置。
# ONEBOT_ACCESS_TOKEN=

# 命令前缀。诊断命令用 /diag 触发，如果没有反应，检查这一项。
COMMAND_START=["/"]

# 验收脚本。填写这两项后，helloyunhu 连上框架时会自动跑一轮检查；也可以随时在群里
# 发送 /m2check 手动重跑。留空则不执行任何主动发送，正常使用不需要填。
# M2_CHECK_GROUP=群号
# M2_CHECK_USER=群主或管理员的 QQ 号
# M2_CHECK_DELAY=5
# 用于重启后的引用验证，填上一轮结果里的消息标识。
# M2_CHECK_REPLY_TO=
